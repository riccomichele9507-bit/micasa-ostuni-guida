# MiCasa Ostuni — environment variables
# Copy this file to `.env` and fill in real values for local development.
# In production, set these in the Vercel dashboard (Settings → Environment Variables).
#
# IMPORTANT: these are SERVER-SIDE ONLY (used by /api/chat).
# Never prefix an API key with VITE_ — anything VITE_* is bundled into the browser.

# OpenAI API key — get one at https://platform.openai.com
OPENAI_API_KEY=

# Model used by the in-app AI assistant (it uses web search for Ostuni/Puglia)
OPENAI_MODEL=gpt-4.1
